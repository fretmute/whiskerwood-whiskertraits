blueprint AC_Trait_Debug : AC_TraitBase at /Game/Mods/WhiskerTraits/Behaviours/AC_Trait_Debug

// Phase 1 test component: registered by BP_TraitManager for DebugTraitKey (off when that is None).
// Changes nothing; logs what the BPL_WhiskerState reads see on its first evaluation and every LogEvery evaluations.

var LogEvery: int = 120

on Evaluate {
    if Evaluations == 1 || Evaluations % LogEvery == 0 {
        BPL_WhiskerState.Log("debug id=" + string(Agent.m_characteristics.ID) + " eval=" + string(Evaluations) + " carried=" + string(BPL_WhiskerState.GetCarriedItemCount(Agent)) + " workplace=" + string(BPL_WhiskerState.GetWorkplaceKey(Agent)) + " recipe=" + string(BPL_WhiskerState.GetActiveRecipe(Agent)) + " action=" + Agent.m_state.currentActionDesc + " speed=" + string(Agent.m_state.derived_speedPercent))
    }
}

on OnRemoved {
    BPL_WhiskerState.Log("debug id=" + string(Agent.m_characteristics.ID) + " removed after " + string(Evaluations) + " evaluations")
}
